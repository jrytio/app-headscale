#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Addon: Headscale
# TEMPORARY (Task 4): do NOT halt the container on Tailscale failure.
#
# The old tailscaled longrun needs a real TUN device + CAP_NET_ADMIN, which
# the unprivileged standalone test harness (docker-compose.test.yml) does not
# grant. tailscaled reliably fails ~30s after boot in that environment, and
# this service's halt-on-failure would otherwise take the whole container
# down before headscale (owned by Task 4) can be probed. Tasks 5-9 rewrite
# tailscaled properly; restore CANONICAL-FINISH halt behavior there.
# ==============================================================================
readonly exit_code_service="${1}"
readonly exit_code_signal="${2}"
readonly service="Tailscale"

bashio::log.info \
    "Service ${service} exited with code ${exit_code_service}" \
    "(by signal ${exit_code_signal}) — halt disabled pending rewrite"
