#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Addon: Headscale
# Runs Tailscale: HA node (real TUN) + optional subnet router (userspace)
# ==============================================================================

readonly HA_AUTH_KEY_FILE="/data/tailscale/ha_auth_key"
readonly SUBNET_AUTH_KEY_FILE="/data/tailscale/subnet_auth_key"
readonly HA_SOCKET="/var/run/tailscale/ha.sock"
readonly SUBNET_SOCKET="/var/run/tailscale/subnet.sock"
readonly ACL_SETUP_FILE="/data/headplane/acl_configured"

mkdir -p /var/run/tailscale

# Ensure TUN device exists
if [ ! -c /dev/net/tun ]; then
    mkdir -p /dev/net
    mknod /dev/net/tun c 10 200 2>/dev/null || true
fi

# Cleanup handler for both tailscaled processes
cleanup() {
    kill "${HA_PID:-}" "${SUBNET_PID:-}" 2>/dev/null
    wait
}
trap cleanup EXIT TERM

# Helper: wait for a tailscaled socket to be ready
wait_for_socket() {
    local socket="$1"
    local i
    for i in $(seq 1 30); do
        [ -S "${socket}" ] && return 0
        sleep 1
    done
    bashio::log.warning "Timed out waiting for socket: ${socket}"
    return 1
}

# --- Start Home Assistant tailscale node (real TUN) ---
bashio::log.info "Starting Tailscale for Home Assistant..."

tailscaled \
    --statedir="/data/tailscale/ha" \
    --socket="${HA_SOCKET}" &
HA_PID=$!

wait_for_socket "${HA_SOCKET}"

if bashio::fs.file_exists "${HA_AUTH_KEY_FILE}"; then
    ha_key=$(cat "${HA_AUTH_KEY_FILE}")
    bashio::log.info "Registering Home Assistant on tailnet..."
    if timeout 30 tailscale --socket="${HA_SOCKET}" up \
        --login-server "${TS_LOGIN_SERVER}" \
        --authkey "${ha_key}" \
        --hostname "homeassistant" \
        --accept-dns=false \
        --accept-routes=false 2>&1; then
        ts_ip=$(tailscale --socket="${HA_SOCKET}" ip -4 2>/dev/null) || true
        bashio::log.info "Home Assistant is on the tailnet!"
        bashio::log.info "Tailnet IP: ${ts_ip}"
        bashio::log.info "Access HA remotely at: http://${ts_ip}:8123"

        # Set ACL policy on first run only (don't overwrite user customizations)
        if ! bashio::fs.file_exists "${ACL_SETUP_FILE}"; then
            # Build group:users list from HA user accounts (username@ format)
            users_json="[]"
            if [ -f /data/headplane/ha_users.txt ] && [ -s /data/headplane/ha_users.txt ]; then
                users_json=$(jq -Rs '[split("\n")[] | select(length > 0) | . + "@"]' /data/headplane/ha_users.txt)
            fi

            acl_tmp="/tmp/acl_policy.hujson"
            cat > "${acl_tmp}" <<ACLEOF
{
    "hosts": {
        "ha": "${ts_ip}/32"
    },
    "groups": {
        // Full access to Home Assistant and the LAN subnet
        "group:admins": [],

        // Access to Home Assistant only (all ports)
        // Home Assistant users are automatically added here
        "group:users": ${users_json},

        // Access to the LAN subnet via the subnet router
        // To grant a user subnet access, add them here:
        //   "group:subnet-access": ["username@"]
        "group:subnet-access": []
    },
    "acls": [
        // Admins: full access to everything including LAN subnet
        {"action": "accept", "src": ["group:admins"], "dst": ["*:*"]},

        // Users: access to all ports on the Home Assistant machine
        {"action": "accept", "src": ["group:users"], "dst": ["ha:*"]},

        // Subnet access: route traffic to the LAN via the subnet router
        // Members of this group can reach devices on your local network
        // (e.g. printers, NAS, cameras) through the headscale-subnet-router
        // No users are granted this by default — add them to group:subnet-access above
        {"action": "accept", "src": ["group:subnet-access"], "dst": ["${TS_ROUTES:-10.0.0.0/8}:*"]},

        // Default: everyone on the tailnet can reach HA on port 8123
        {"action": "accept", "src": ["autogroup:member"], "dst": ["ha:8123"]}
    ]
}
ACLEOF
            if headscale policy set --force -f "${acl_tmp}" --config /data/headscale/config.yaml 2>/dev/null; then
                printf '%s' "1" > "${ACL_SETUP_FILE}"
                bashio::log.info "ACL policy applied (HA at ${ts_ip})"
            fi
        else
            bashio::log.info "Using existing ACL policy (edit in Headplane UI)."
        fi
    else
        bashio::log.warning "Home Assistant tailscale connection timed out."
    fi
else
    bashio::log.warning "No HA auth key — Home Assistant not registered on tailnet."
fi

# --- Start subnet router (userspace networking, separate instance) ---
if bashio::config.true 'subnet_router.enabled' && bashio::fs.file_exists "${SUBNET_AUTH_KEY_FILE}"; then
    bashio::log.info "Starting Tailscale subnet router..."

    tailscaled \
        --statedir="/data/tailscale/subnet" \
        --socket="${SUBNET_SOCKET}" \
        --tun=userspace-networking &
    SUBNET_PID=$!

    wait_for_socket "${SUBNET_SOCKET}"

    subnet_key=$(cat "${SUBNET_AUTH_KEY_FILE}")

    declare -a subnet_args
    subnet_args+=(--login-server "${TS_LOGIN_SERVER}")
    subnet_args+=(--authkey "${subnet_key}")
    subnet_args+=(--hostname "headscale-subnet-router")

    if bashio::var.has_value "${TS_ROUTES}"; then
        subnet_args+=(--advertise-routes "${TS_ROUTES}")
    fi

    if [[ "${TS_EXIT_NODE}" == "true" ]]; then
        subnet_args+=(--advertise-exit-node)
    fi

    bashio::log.info "Connecting subnet router..."
    if timeout 30 tailscale --socket="${SUBNET_SOCKET}" up "${subnet_args[@]}" 2>&1; then
        bashio::log.info "Subnet router connected. Routes: ${TS_ROUTES}"

        # Auto-approve subnet routes
        subnet_node_id=$(headscale nodes list --config /data/headscale/config.yaml -o json 2>/dev/null \
            | jq -r '.[] | select(.name=="headscale-subnet-router") | .id') || true
        if bashio::var.has_value "${subnet_node_id}" && bashio::var.has_value "${TS_ROUTES}"; then
            if headscale nodes approve-routes --identifier "${subnet_node_id}" --routes "${TS_ROUTES}" \
                --config /data/headscale/config.yaml 2>/dev/null; then
                bashio::log.info "Subnet routes auto-approved: ${TS_ROUTES}"
            fi
        fi
    else
        bashio::log.warning "Subnet router connection timed out."
    fi
fi

# Wait for processes
if [ -n "${SUBNET_PID:-}" ]; then
    wait -n ${HA_PID} ${SUBNET_PID}
else
    wait ${HA_PID}
fi
