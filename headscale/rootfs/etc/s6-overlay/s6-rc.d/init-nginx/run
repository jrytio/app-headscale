#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Addon: Headscale
# Configures Nginx reverse proxy
# ==============================================================================

bashio::log.info "Configuring Nginx..."

mkdir -p /etc/nginx/servers

# Generate upstream config
bashio::var.json \
    port "^3000" \
    | tempio \
        -template /etc/nginx/templates/upstream.gtpl \
        -out /etc/nginx/servers/upstream.conf

# Generate ingress config
ingress_port=$(bashio::app.ingress_port)
bashio::log.info "Ingress port: ${ingress_port}"
bashio::var.json \
    port "^${ingress_port}" \
    | tempio \
        -template /etc/nginx/templates/ingress.gtpl \
        -out /etc/nginx/servers/ingress.conf

# Generate direct access config. bashio::app.port only tells us whether the
# user has this port mapped (and to what HOST port) — it must NOT be used as
# the listen port here. Under bridge networking the Supervisor forwards
# host_port -> container_port 8080, so nginx inside the container must always
# listen on the fixed container-side port 8080 regardless of what host port
# it's mapped to.
if bashio::var.has_value "$(bashio::app.port 8080)"; then
    bashio::log.info "Direct access enabled (container port 8080)"
    bashio::var.json \
        port "^8080" \
        | tempio \
            -template /etc/nginx/templates/direct.gtpl \
            -out /etc/nginx/servers/direct.conf
fi

bashio::log.info "Nginx configuration complete."
